# Plane AI Service Configuration
PORT=8001
AI_SERVICE_SECRET=your-secure-internal-ai-service-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# Plane Backend Integration
# Must include the /api/v1 prefix: the retriever and tools append
# /workspaces/<slug>/... directly to this value.
PLANE_API_URL=http://localhost:8000/api/v1
# Required. Without it the service fails the run instead of inventing context.
PLANE_API_TOKEN=your-plane-api-token

# LLM Providers Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
