{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

(plane_proxy) {
	# The inbound email webhook carries the whole message -- bodies and every
	# attachment -- in one request, so FILE_SIZE_LIMIT (a per-file limit) would
	# reject legitimate mail here. A 413 makes the provider redeliver, so this
	# has to match the ceiling the endpoint itself enforces.
	@helpdesk_inbound path /api/helpdesk/public/inbound/*
	request_body @helpdesk_inbound {
		max_size {$HELPDESK_INBOUND_MAX_BODY_SIZE:30MB}
	}

	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000

	reverse_proxy /live/* live:3000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{$SITE_ADDRESS} {
	import plane_proxy
}